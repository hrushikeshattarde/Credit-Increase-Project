# Copy to .env and fill in. Never commit .env or any service-account JSON.

# ---- Transport Pro public API (required) ----
TPRO_BASE_URL=https://cli.transportpro.net/publicapi/v1
TPRO_USERNAME=
TPRO_PASSWORD=

# ---- Gmail (service account with domain-wide delegation: gmail.readonly + gmail.compose) ----
# Mailbox impersonated; teamcredit@ is a Google Group and cannot be impersonated, so use a
# member mailbox that receives the group mail.
GMAIL_USER=
TEAMCREDIT_ADDRESS=teamcredit@circledelivers.com
FORM_SENDER=formresponse@circledelivers.com
GOOGLE_SERVICE_ACCOUNT_FILE=gmail-service-account.json
EMAIL_LOOKBACK_DAYS=14

# ---- Transport Pro searches ----
LOOKBACK_DAYS=365
MISSING_DOCS_WORKERS=8
POLL_SECONDS=300
# EXTRA_CC=

# ---- Google Chat approval cards (optional) ----
# drafts = save the reply to GMAIL_USER's Drafts; chat = post an approval card.
APPROVAL_MODE=drafts
CHAT_SPACE=
CHAT_SA_FILE=chat-service-account.json
# Outputs of the creditbot stack (python deploy/deploy.py): CallbackUrl and StateBucket.
CHAT_ACTION_URL=
APPROVALS_BUCKET=
